# Copy to .env and adjust. Every variable is optional; the defaults are
# the ones in app/config.py.

# --- Service ---------------------------------------------------------
FAIREDIT_LOG_LEVEL=INFO
FAIREDIT_LOG_JSON=false

# Shared secret for the /v1 inference routes. Leave empty on a private
# network. SET THIS before exposing the service to the internet — without
# it anyone who can reach the port can spend your GPU.
FAIREDIT_API_KEY=

# Comma-separated browser origins. Only needed for a Flutter web build;
# mobile clients are not subject to CORS.
FAIREDIT_CORS_ORIGINS=

# --- Compute ---------------------------------------------------------
# auto | cuda | mps | cpu
FAIREDIT_DEVICE=auto
FAIREDIT_USE_FP16=true

# Load every model at startup. Costs ~30s of boot and buys a predictable
# first request — worth it behind a health-checked load balancer.
FAIREDIT_EAGER_LOAD=false

# Concurrent GPU jobs. Keep at 1 per physical GPU: two forward passes on
# one device contend for VRAM and finish slower than if they had queued.
FAIREDIT_GPU_WORKERS=1
FAIREDIT_MAX_QUEUE_DEPTH=16
FAIREDIT_INFERENCE_TIMEOUT_S=120

# --- Limits ----------------------------------------------------------
FAIREDIT_MAX_UPLOAD_MB=25
FAIREDIT_MAX_INFERENCE_DIMENSION=1536

# --- Model locations -------------------------------------------------
# Defaults resolve under backend/weights and backend/vendor.
FAIREDIT_SAM2_HF_ID=facebook/sam2.1-hiera-large
# FAIREDIT_SAM2_CHECKPOINT=/weights/sam2.1_hiera_large.pt
# FAIREDIT_SAM2_CONFIG=configs/sam2.1/sam2.1_hiera_large.yaml

# FAIREDIT_GROUNDING_CHECKPOINT=/weights/groundingdino_swint_ogc.pth
FAIREDIT_GROUNDING_BOX_THRESHOLD=0.30
FAIREDIT_GROUNDING_TEXT_THRESHOLD=0.25

# FAIREDIT_LAMA_DIR=/weights/big-lama
FAIREDIT_LAMA_MAX_DIMENSION=1024
